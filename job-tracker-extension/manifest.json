{
    "manifest_version": 3,
    "name": "Job Tracker Auto-fill",
    "version": "1.0",
    "description": "1-click auto-fill job applications into the Job Tracker backend.",
    "permissions": [
        "activeTab",
        "scripting",
        "storage"
    ],
    "host_permissions": [
        "*://*.linkedin.com/*",
        "*://*.indeed.com/*",
        "*://*.onrender.com/*",
        "https://job-tracker-iwj8.onrender.com/*",
        "http://localhost:8000/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html",
        "default_title": "Save Job to Tracker"
    },
    "content_scripts": [
        {
            "matches": [
                "*://*.linkedin.com/*",
                "*://*.indeed.com/*"
            ],
            "js": [
                "content.js"
            ]
        }
    ]
}